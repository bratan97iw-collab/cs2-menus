# vim: set sts=2 ts=8 sw=2 tw=99 et ft=python:
import os

# Game Utils / Metamod 1483: skip source files removed from newer HL2SDK layouts.
# This only changes the compilation source list, not plugin behavior.
for sdk_target in MMSPlugin.sdk_targets:
  sdk = sdk_target.sdk
  cxx = sdk_target.cxx

  cxx.cxxflags += ['-Wno-invalid-offsetof', '-Wno-reorder-ctor']
  if cxx.target.platform == 'linux':
    cxx.defines += [
      'bswap_16=__builtin_bswap16',
      'bswap_32=__builtin_bswap32',
      'bswap_64=__builtin_bswap64',
    ]
  binary = MMSPlugin.HL2Library(builder, cxx, MMSPlugin.plugin_name, sdk)

  binary.compiler.cxxincludes += [
    os.path.join(builder.currentSourcePath, 'funchook', 'include'),
    os.path.join(builder.sourcePath, 'include'),
    os.path.join(builder.sourcePath, '..', 'SchemaEntity'),
    # SchemaEntity/ctimer.h includes utlvector.h without tier1/ prefix.
    os.path.join(sdk['path'], 'public', 'tier1'),
  ]

  if binary.compiler.target.platform == 'linux':
    binary.compiler.postlink += [
      os.path.join(builder.sourcePath, 'funchook', 'lib', 'libfunchook.a'),
      os.path.join(builder.sourcePath, 'funchook', 'lib', 'libdistorm.a'),
    ]
  elif binary.compiler.target.platform == 'windows':
    binary.compiler.postlink += [
      'psapi.lib',
      os.path.join(builder.sourcePath, 'funchook', 'lib', 'funchook.lib'),
      os.path.join(builder.sourcePath, 'funchook', 'lib', 'distorm.lib'),
    ]

  proto_dir = os.path.join(sdk['path'], 'thirdparty', 'game_protobufs', 'csgo')
  proto_sources = [
    os.path.join(proto_dir, f) for f in [
      'networksystem_protomessages.proto',
      'valveextensions.proto',
      'network_connection.proto',
      'networkbasetypes.proto',
      'engine_gcmessages.proto',
      'netmessages.proto',
      'gameevents.proto',
      'usercmd.proto',
      'usermessages.proto',
      'source2_steam_stats.proto',
    ]
  ]
  proto_sources.append(os.path.join(builder.sourcePath, 'customhud.proto'))
  binary.custom = [builder.tools.Protoc(protoc=sdk_target.protoc, sources=proto_sources)]
  binary.sources += [
    'utils.cpp',
    'plugin_autoload.cpp',
    'menu_render.cpp',
    'api_utils.cpp',
    'api_players.cpp',
    'api_layout.cpp',
    os.path.join('..', 'SchemaEntity', 'schemasystem.cpp'),
    os.path.join('..', 'SchemaEntity', 'module.cpp'),
    os.path.join('..', 'SchemaEntity', 'ctimer.cpp'),
  ]

  # HL2Library() can register SDK C++ files which no longer exist in current
  # CS2 headers. Remove only files INSIDE this SDK tree which are absent.
  # Keep project sources intact, so missing project files remain visible errors.
  sdk_root = os.path.normpath(os.path.abspath(sdk['path']))
  filtered_sources = []
  missing_sdk_sources = []
  for source in binary.sources:
    source_name = os.fspath(source)
    if os.path.isabs(source_name):
      candidate = os.path.normpath(source_name)
      try:
        inside_sdk = os.path.commonpath([sdk_root, candidate]) == sdk_root
      except ValueError:
        inside_sdk = False
      if inside_sdk and not os.path.isfile(candidate):
        missing_sdk_sources.append(candidate)
        continue
    filtered_sources.append(source)
  binary.sources = filtered_sources
  for missing in missing_sdk_sources:
    print('Skipped removed SDK translation unit: {}'.format(missing))
  if missing_sdk_sources:
    print('WARNING: skipped {} missing SDK source(s); linker errors may require real replacements.'.format(len(missing_sdk_sources)))

  if cxx.target.arch == 'x86':
    binary.sources += ['sourcehook/sourcehook_hookmangen.cpp']
  nodes = builder.Add(binary)
  MMSPlugin.binaries += [nodes]
